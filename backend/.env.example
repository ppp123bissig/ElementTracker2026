# BACKEND ENVIRONMENT VARIABLES
# Kopiere diese Datei zu .env und fülle mit echten Werten

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=elementtracker
DATABASE_USER=elementtracker
DATABASE_PASSWORD=your_secure_password_here

# JWT Secret (mind. 32 Zeichen, random generieren)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here_change_me

# Admin Default (nur beim setup, dann ändern!)
ADMIN_DEFAULT_PASSWORD=temporary_setup_password

# Redis (für Sessions & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (für Benachrichtigungen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@elementtracker.local

# Site Configuration
SITE_NAME=ElementTracker
SITE_DESCRIPTION=Tracking System für Datenelemente
SUPPORT_EMAIL=support@example.com
BASE_URL=https://elementtracker.local

# File Upload
PHOTO_MAX_SIZE_MB=3
PHOTO_UPLOAD_PATH=/var/www/elementtracker/uploads/photos
ALLOWED_PHOTO_TYPES=image/jpeg,image/png

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/elementtracker/backend.log

# Security
CORS_ORIGIN=https://elementtracker.local
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
