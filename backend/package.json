    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "joi": "^17.11.1",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
