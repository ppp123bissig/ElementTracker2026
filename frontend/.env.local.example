# Frontend Environment Variables (optional)
# Used to override default API URL for remote access

# Uncomment one of these depending on your setup:

# For local development (default, backend on same machine):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# For access from another PC on the same network (replace with your server IP):
# NEXT_PUBLIC_API_BASE_URL=http://192.168.1.100:3000

# For access from mobile on the same network:
# NEXT_PUBLIC_API_BASE_URL=http://10.0.2.15:3000

# To use: Copy this to .env.local and uncomment your desired URL
